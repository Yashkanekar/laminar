{
  "name": "laminar-ui",
  "private": false,
  "version": "0.1.1",
  "description": "A React library for rendering UIs from streaming LLM / backend responses",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/laminar.css"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@types/mdast": "^4.0.4",
    "partial-json": "^0.1.7",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "shiki": "^4.2.0",
    "unified": "^11.0.5"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vite-plugin-dts": "^5.0.2"
  },
  "keywords": [
    "react",
    "llm",
    "streaming",
    "markdown",
    "ai",
    "chatgpt",
    "anthropic",
    "openai",
    "stream",
    "sse",
    "chat",
    "gpt",
    "generative-ui"
  ]
}
